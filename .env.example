# ── Supabase ────────────────────────────────────────────────────────────────
# Obtenha em: https://supabase.com/dashboard → seu projeto → Settings → API
# NEXT_PUBLIC_ significa que é exposta no browser (seguro para chaves anon)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Opcional: URL base do app (usada em og:image, sitemaps, etc.) ──────────
# Em produção coloque o domínio da Vercel ou domínio próprio
NEXT_PUBLIC_APP_URL=https://wavesx.vercel.app
